<template xmlns="http://www.xfa.org/schema/xfa-template/3.3/"><subform name="form1" layout="position" x="0in" y="0in" w="8.5in" h="11in"><pageSet relation="orderedOccurrence"><pageArea name="Page1" id="Page1"><contentArea x="0.5in" y="0.5in" w="7.5in" h="10in"/><medium short="8.5in" long="11in" stock="default"/></pageArea></pageSet><draw name="TitleText" x="0.5in" y="0.25in" w="6in" h="0.3in"><font typeface="Helvetica" size="14pt"/><value><text>Order Calculator - FormCalc Demo</text></value></draw><draw name="LblCustomer" x="0.5in" y="0.7in" w="0.9in" h="0.25in"><font typeface="Helvetica" size="8pt"/><value><text>Customer:</text></value></draw><field name="CustomerFirstName" x="1.4in" y="0.7in" w="1.1in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="dataRef" ref="$data.Order.Customer.FirstName"/></field><field name="CustomerLastName" x="2.5in" y="0.7in" w="1.1in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="dataRef" ref="$data.Order.Customer.LastName"/></field><draw name="LblFullName" x="3.7in" y="0.7in" w="1.4in" h="0.25in"><font typeface="Helvetica" size="8pt"/><value><text>Full Name (Concat):</text></value></draw><field name="FullName" x="5.1in" y="0.7in" w="1.4in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="none"/><calculate><script contentType="application/x-formcalc">
Concat(CustomerFirstName, " ", CustomerLastName)
</script></calculate></field><draw name="LblInitial" x="6.6in" y="0.7in" w="0.6in" h="0.25in"><font typeface="Helvetica" size="8pt"/><value><text>Initial:</text></value></draw><field name="CustomerInitial" x="7.2in" y="0.7in" w="0.4in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="none"/><calculate><script contentType="application/x-formcalc">
Upper(Left(CustomerFirstName, 1))
</script></calculate></field><draw name="LblOrderDate" x="0.5in" y="1in" w="1in" h="0.25in"><font typeface="Helvetica" size="8pt"/><value><text>Order Date:</text></value></draw><field name="OrderDate" x="1.5in" y="1in" w="1.2in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="dataRef" ref="$data.Order.OrderDate"/></field><draw name="LblDate2Num" x="2.8in" y="1in" w="0.9in" h="0.25in"><font typeface="Helvetica" size="8pt"/><value><text>Date2Num:</text></value></draw><field name="OrderDateNum" x="3.7in" y="1in" w="0.8in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="none"/><calculate><script contentType="application/x-formcalc">
Date2Num(OrderDate)
</script></calculate></field><draw name="LblFormatted" x="4.6in" y="1in" w="1.8in" h="0.25in"><font typeface="Helvetica" size="8pt"/><value><text>Formatted (Num2Date+DateFmt):</text></value></draw><field name="OrderDateFormatted" x="6.4in" y="1in" w="0.9in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="none"/><calculate><script contentType="application/x-formcalc">
Num2Date(OrderDateNum, DateFmt(1))
</script></calculate></field><draw name="HdrItem" x="0.5in" y="1.35in" w="1.3in" h="0.2in"><font typeface="Helvetica" size="8pt"/><value><text>Item</text></value></draw><draw name="HdrQty" x="1.9in" y="1.35in" w="0.6in" h="0.2in"><font typeface="Helvetica" size="8pt"/><value><text>Qty</text></value></draw><draw name="HdrPrice" x="2.6in" y="1.35in" w="0.9in" h="0.2in"><font typeface="Helvetica" size="8pt"/><value><text>Unit Price</text></value></draw><draw name="HdrTotal" x="3.6in" y="1.35in" w="1.6in" h="0.2in"><font typeface="Helvetica" size="8pt"/><value><text>Line Total (Qty*Price)</text></value></draw><field name="Item1Desc" x="0.5in" y="1.65in" w="1.3in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="dataRef" ref="$data.Order.Item1.Description"/></field><field name="Item1Qty" x="1.9in" y="1.65in" w="0.6in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="dataRef" ref="$data.Order.Item1.Qty"/></field><field name="Item1Price" x="2.6in" y="1.65in" w="0.9in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="dataRef" ref="$data.Order.Item1.Price"/></field><field name="Item1Total" x="3.6in" y="1.65in" w="1in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="none"/><calculate><script contentType="application/x-formcalc">
Item1Qty * Item1Price
</script></calculate></field><field name="Item2Desc" x="0.5in" y="1.9in" w="1.3in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="dataRef" ref="$data.Order.Item2.Description"/></field><field name="Item2Qty" x="1.9in" y="1.9in" w="0.6in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="dataRef" ref="$data.Order.Item2.Qty"/></field><field name="Item2Price" x="2.6in" y="1.9in" w="0.9in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="dataRef" ref="$data.Order.Item2.Price"/></field><field name="Item2Total" x="3.6in" y="1.9in" w="1in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="none"/><calculate><script contentType="application/x-formcalc">
Item2Qty * Item2Price
</script></calculate></field><field name="Item3Desc" x="0.5in" y="2.15in" w="1.3in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="dataRef" ref="$data.Order.Item3.Description"/></field><field name="Item3Qty" x="1.9in" y="2.15in" w="0.6in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="dataRef" ref="$data.Order.Item3.Qty"/></field><field name="Item3Price" x="2.6in" y="2.15in" w="0.9in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="dataRef" ref="$data.Order.Item3.Price"/></field><field name="Item3Total" x="3.6in" y="2.15in" w="1in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="none"/><calculate><script contentType="application/x-formcalc">
Item3Qty * Item3Price
</script></calculate></field><draw name="LblSummary" x="0.5in" y="2.5in" w="3in" h="0.25in"><font typeface="Helvetica" size="10pt"/><value><text>Order Summary</text></value></draw><draw name="LblTotalQty" x="0.5in" y="2.8in" w="1.6in" h="0.25in"><font typeface="Helvetica" size="8pt"/><value><text>Total Qty (Sum):</text></value></draw><field name="TotalQty" x="2.2in" y="2.8in" w="0.6in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="none"/><calculate><script contentType="application/x-formcalc">
Sum(Item1Qty, Item2Qty, Item3Qty)
</script></calculate></field><draw name="LblSubtotal" x="0.5in" y="3.05in" w="1.9in" h="0.25in"><font typeface="Helvetica" size="8pt"/><value><text>Subtotal (Sum of Totals):</text></value></draw><field name="Subtotal" x="2.5in" y="3.05in" w="1in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="none"/><calculate><script contentType="application/x-formcalc">
Sum(Item1Total, Item2Total, Item3Total)
</script></calculate></field><draw name="LblAvg" x="0.5in" y="3.3in" w="2in" h="0.25in"><font typeface="Helvetica" size="8pt"/><value><text>Avg Unit Price (Round+Avg):</text></value></draw><field name="AvgUnitPrice" x="2.6in" y="3.3in" w="0.9in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="none"/><calculate><script contentType="application/x-formcalc">
Round(Avg(Item1Price, Item2Price, Item3Price), 2)
</script></calculate></field><draw name="LblCount" x="0.5in" y="3.55in" w="1.9in" h="0.25in"><font typeface="Helvetica" size="8pt"/><value><text>Line-Item Count (Count):</text></value></draw><field name="ItemCount" x="2.5in" y="3.55in" w="0.5in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="none"/><calculate><script contentType="application/x-formcalc">
Count(Item1Qty, Item2Qty, Item3Qty)
</script></calculate></field><draw name="LblThreshold" x="0.5in" y="3.8in" w="1.6in" h="0.25in"><font typeface="Helvetica" size="8pt"/><value><text>Discount Threshold:</text></value></draw><field name="DiscountThreshold" x="2.2in" y="3.8in" w="0.6in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="dataRef" ref="$data.Order.DiscountThreshold"/></field><draw name="LblTier" x="0.5in" y="4.05in" w="1.5in" h="0.25in"><font typeface="Helvetica" size="8pt"/><value><text>Discount Tier (If):</text></value></draw><field name="DiscountLabel" x="2.1in" y="4.05in" w="1.6in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="none"/><calculate><script contentType="application/x-formcalc">
If(Subtotal &gt;= DiscountThreshold, "Bulk Discount", "Standard")
</script></calculate></field><draw name="LblDiscAmt" x="0.5in" y="4.3in" w="2in" h="0.25in"><font typeface="Helvetica" size="8pt"/><value><text>Discount Amount (If+Round):</text></value></draw><field name="DiscountAmount" x="2.6in" y="4.3in" w="0.9in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="none"/><calculate><script contentType="application/x-formcalc">
If(Subtotal &gt;= DiscountThreshold, Round(Subtotal * 0.10, 2), 0)
</script></calculate></field><draw name="LblGrand" x="0.5in" y="4.55in" w="2.2in" h="0.25in"><font typeface="Helvetica" size="10pt"/><value><text>Grand Total (Subtotal-Discount):</text></value></draw><field name="GrandTotal" x="2.8in" y="4.55in" w="1in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="none"/><calculate><script contentType="application/x-formcalc">
Subtotal - DiscountAmount
</script></calculate></field></subform></template>