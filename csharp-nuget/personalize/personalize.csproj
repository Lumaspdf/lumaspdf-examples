<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generated by tools/gen_nuget_examples.py. Consumes the LumasPDF.Net
       NuGet package exactly as a customer would: no wrapper source is compiled
       in and no native DLL is copied by hand. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>personalize</RootNamespace>
    <AssemblyName>personalize</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The examples are ports of Delphi originals and use plenty of
         deliberately terse P/Invoke; their warnings are not the product. -->
    <NoWarn>$(NoWarn);CS0618;CS0168;CS0219;CS8981</NoWarn>
    <!-- x64 to match the Delphi reference build, so a byte comparison of the
         output measures the port and not an x86-vs-x64 engine difference. -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Build straight into the project folder, the way every other language
         tree in examples/ is laid out. Without this the exe and its artifacts
         land in bin/Release/<tfm>/<rid>/, which the fleet runner and the output
         comparer would both have to be taught about, and which puts out.pdf
         somewhere no example's own relative paths expect. -->
    <OutputPath>.</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <BaseOutputPath>.</BaseOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\csharp\personalize\personalize.cs" />
    <!-- Data the example reads from its own directory (certificates, ICC
         profiles, source PDFs, XFA packets). Copied so the exe sees them where
         its relative paths look. -->
    <None Include="*.pfx;*.icc;*.ICC;*.lrpt;*.xdp;*.xml;*.emf;*.wmf;*.ttf;*.csv;in.pdf;license.pdf;taxform.pdf;rotated_270.pdf"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LumasPDF.Net" Version="4.2.2" />
  </ItemGroup>

</Project>
