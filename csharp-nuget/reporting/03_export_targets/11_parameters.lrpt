<?xml version="1.0" encoding="UTF-8"?>
<report name="Params" tagLangVersion="1">
 <page width="210" height="297" marginLeft="15" marginTop="15" marginRight="15" marginBottom="15"/>
 <params>
  <param name="Customer" default="ACME (default)"/>
  <param name="UnitPrice" default="0"/>
  <param name="Qty" default="0"/>
 </params>
 <bands>
  <band kind="reportheader" name="rh" height="30">
   <text name="title" x="0" y="0" w="180" h="10" fontSize="18" hAlign="center">Invoice for {{var:Customer}}</text>
   <text name="line1" x="0" y="14" w="180" h="6" fontSize="11">Unit price: {{var:UnitPrice}}   Quantity: {{var:Qty}}</text>
   <text name="line2" x="0" y="22" w="180" h="6" fontSize="11">TOTAL = {{expr: UnitPrice * Qty}}</text>
  </band>
 </bands>
</report>
