<template xmlns="http://www.xfa.org/schema/xfa-template/3.3/"><subform name="form1" layout="position" x="0in" y="0in" w="8.5in" h="11in"><pageSet relation="orderedOccurrence"><pageArea name="Page1" id="Page1"><contentArea x="0.5in" y="0.5in" w="7.5in" h="10in"/><medium short="8.5in" long="11in" stock="default"/></pageArea></pageSet><draw name="TitleText8" x="0.5in" y="0.25in" w="5in" h="0.25in"><font typeface="Helvetica" size="14pt"/><value><text>Purchase Receipt -- Picture-Clause Formatting</text></value></draw><field name="CustomerNameField" x="0.5in" y="1in" w="3.5in" h="0.25in"><font typeface="Helvetica" size="10pt"/><caption placement="left" reserve="1in"><value><text>Customer:</text></value></caption><bind match="dataRef" ref="$data.Receipt.CustomerName"/><ui><textEdit/></ui></field><field name="UnitPriceField" x="0.5in" y="1.5in" w="2in" h="0.25in"><font typeface="Helvetica" size="10pt"/><caption placement="left" reserve="1in"><value><text>Unit Price:</text></value></caption><format><picture>num{zzz,zz9.99}</picture></format><bind match="dataRef" ref="$data.Receipt.UnitPrice"/><ui><numericEdit/></ui></field><field name="DiscountField" x="0.5in" y="2in" w="2in" h="0.25in"><font typeface="Helvetica" size="10pt"/><caption placement="left" reserve="1in"><value><text>Discount:</text></value></caption><format><picture>num{($zzz,zz9.99)}</picture></format><bind match="dataRef" ref="$data.Receipt.Discount"/><ui><numericEdit/></ui></field><field name="PurchaseDateField" x="0.5in" y="2.5in" w="3in" h="0.25in"><font typeface="Helvetica" size="10pt"/><caption placement="left" reserve="1in"><value><text>Date:</text></value></caption><format><picture>date{MMMM DD, YYYY}</picture></format><bind match="dataRef" ref="$data.Receipt.PurchaseDate"/><ui><dateTimeEdit/></ui></field><field name="PhoneField" x="0.5in" y="3in" w="3in" h="0.25in"><font typeface="Helvetica" size="10pt"/><caption placement="left" reserve="1in"><value><text>Phone:</text></value></caption><format><picture>text{999-999-9999}</picture></format><bind match="dataRef" ref="$data.Receipt.Phone"/><ui><textEdit/></ui></field><field name="Item1Price" x="0.5in" y="3.5in" w="1in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="dataRef" ref="$data.Receipt.Item1Price"/></field><field name="Item2Price" x="1.6in" y="3.5in" w="1in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="dataRef" ref="$data.Receipt.Item2Price"/></field><field name="Item3Price" x="2.7in" y="3.5in" w="1in" h="0.25in" access="readOnly"><ui><textEdit/></ui><bind match="dataRef" ref="$data.Receipt.Item3Price"/></field><field name="GrandTotalField" x="0.5in" y="4in" w="2in" h="0.25in"><font typeface="Helvetica" size="10pt"/><caption placement="left" reserve="1in"><value><text>Grand Total:</text></value></caption><format><picture>num{zzz,zz9.99}</picture></format><bind match="dataRef" ref="$data.Receipt.GrandTotalDefault"/><calculate><script contentType="application/x-formcalc">
Item1Price + Item2Price + Item3Price
</script></calculate><ui><numericEdit/></ui></field></subform></template>