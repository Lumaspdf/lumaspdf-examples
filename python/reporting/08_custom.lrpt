<?xml version="1.0" encoding="UTF-8"?>
<report name="CustomProvider" tagLangVersion="1">
 <page width="210" height="297" marginLeft="15" marginTop="15" marginRight="15" marginBottom="15"/>
 <datasources><datasource alias="d" provider="mydata" conn="" query=""/></datasources>
 <bands>
  <band kind="reportheader" name="rh" height="12">
   <text name="t" x="0" y="0" w="180" h="8" fontSize="16" hAlign="center" wordWrap="0">Custom Provider - typed rows</text>
  </band>
  <band kind="pageheader" name="ph" height="7">
   <text name="h1" x="0"   y="0" w="20" h="5" fontSize="9" bold="1" wordWrap="0">Id</text>
   <text name="h2" x="22"  y="0" w="40" h="5" fontSize="9" bold="1" wordWrap="0">Name</text>
   <text name="h3" x="64"  y="0" w="30" h="5" fontSize="9" bold="1" hAlign="right" wordWrap="0">Price</text>
   <text name="h4" x="98"  y="0" w="24" h="5" fontSize="9" bold="1" wordWrap="0">Active</text>
   <text name="h5" x="126" y="0" w="50" h="5" fontSize="9" bold="1" wordWrap="0">Note</text>
  </band>
  <band kind="detail" name="det" height="6" data="d">
   <text name="c1" x="0"   y="0" w="20" h="5" fontSize="9" wordWrap="0">{{Id}}</text>
   <text name="c2" x="22"  y="0" w="40" h="5" fontSize="9" wordWrap="0">{{Name}}</text>
   <text name="c3" x="64"  y="0" w="30" h="5" fontSize="9" hAlign="right" wordWrap="0">{{expr: FORMATNUM('#,##0.00', Price) }}</text>
   <text name="c4" x="98"  y="0" w="24" h="5" fontSize="9" wordWrap="0">{{expr: CSTR(Active) }}</text>
   <text name="c5" x="126" y="0" w="50" h="5" fontSize="9" wordWrap="0">{{expr: IFNULL(Note, '(none)') }}</text>
  </band>
 </bands>
</report>
