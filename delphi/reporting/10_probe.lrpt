<?xml version="1.0" encoding="UTF-8"?>
<report name="Groups" tagLangVersion="1">
 <page width="210" height="297" marginLeft="15" marginTop="15" marginRight="15" marginBottom="15"/>
 <datasources><datasource alias="d" provider="csv" conn="10_data.csv"/></datasources>
 <bands>
  <band kind="reportheader" name="rh" height="10"><text name="t" x="0" y="0" w="180" h="8" fontSize="16" hAlign="center" wordWrap="0">Grouped Catalog</text></band>
  <band kind="groupheader" name="gh" group="d.Cat" height="7"><text name="g" x="0" y="1" w="180" h="5" fontSize="12" bold="1" wordWrap="0">Category: {{expr: d.Cat}}</text></band>
  <band kind="detail" name="det" height="5" data="d"><text name="i" x="6" y="0" w="120" h="4" fontSize="9" wordWrap="0">{{Item}}</text><text name="a" x="130" y="0" w="40" h="4" fontSize="9" hAlign="right" wordWrap="0">{{Amount}}</text></band>
  <band kind="groupfooter" name="gf" group="d.Cat" height="6">
   <text name="gt" x="4" y="0" w="176" h="5" fontSize="9" bold="1" wordWrap="0">{{expr: d.Cat}} total = {{expr: SUM(Amount) }}  (n={{expr: COUNT(Amount) }})</text>
  </band>
  <band kind="summary" name="sm" height="8">
   <text name="s" x="4" y="1" w="176" h="6" fontSize="11" bold="1" wordWrap="0">GRAND TOTAL = {{expr: SUM(Amount) }}</text>
  </band>
 </bands>
</report>
