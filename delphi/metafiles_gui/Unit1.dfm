    object Panel4: TPanel
      Left = 0
      Top = 221
      Width = 218
      Height = 461
      Align = alBottom
      BevelOuter = bvNone
      TabOrder = 0
      object Label1: TLabel
        Left = 10
        Top = 10
        Width = 146
        Height = 16
        Caption = 'PDF conversion options:'
      end
      object cbxDebug: TCheckBox
        Left = 25
        Top = 30
        Width = 70
        Height = 20
        Hint = 
          'If set, LumasPDF writes debug comments into the content stream. D' +
          'isable compression so that you can view the PDF file in a text e' +
          'ditor.'
        Caption = 'Debug'
        ParentShowHint = False
        ShowHint = True
        TabOrder = 0
        OnClick = cbxDebugClick
      end
      object cbxClipView: TCheckBox
        Left = 25
        Top = 69
        Width = 89
        Height = 21
        Hint = 
          'Draw the file into a clipping rectangle in the size of the outpu' +
          't rectangle. This flag is normally not required.'
        Caption = 'Clip View'
        ParentShowHint = False
        ShowHint = True
        TabOrder = 2
        OnMouseUp = cbxClipViewMouseUp
      end
      object cbxUseRclBounds: TCheckBox
        Left = 25
        Top = 335
        Width = 119
        Height = 21
        Hint = 
          'Ignore rclFrame and use the raw bounding box of the EMF file ins' +
          'tead. This flag can be useful if a file contains an invalid rclF' +
          'rame rectangle'
        Caption = 'Use rclBounds'
        ParentShowHint = False
        ShowHint = True
        TabOrder = 14
        OnClick = cbxUseRclBoundsClick
      end
      object cbxNoTextScale: TCheckBox
        Left = 25
        Top = 295
        Width = 119
        Height = 21
        Hint = 
          'If set, the intercharacter spacing array of text records is igno' +
          'red. This can cause wrong output but it can also increase the ou' +
          'tput qualitiy for low resolution EMF files.'
        Caption = 'Draw text as is'
        ParentShowHint = False
        ShowHint = True
        TabOrder = 12
      end
      object cbxUnicode: TCheckBox
        Left = 25
        Top = 128
        Width = 109
        Height = 21
        Hint = 'Process text always as Unicode'
        Caption = 'Use Unicode'
        Checked = True
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clGreen
        Font.Height = -15
        Font.Name = 'MS Sans Serif'
        Font.Style = []
        ParentFont = False
        ParentShowHint = False
        ShowHint = True
        State = cbChecked
        TabOrder = 5
        OnClick = cbxUnicodeClick
      end
      object cbxCompress: TCheckBox
        Left = 25
        Top = 49
        Width = 109
        Height = 21
        Caption = 'Compress file'
        Checked = True
        State = cbChecked
        TabOrder = 1
        OnClick = cbxCompressClick
      end
      object cbxUseTextScaling: TCheckBox
        Left = 25
        Top = 315
        Width = 124
        Height = 21
        Hint = 
          'The difference in comparison to the flag mfNoTextScaling is that' +
          ' the intercharacter spacing array is used to compute the string ' +
          'width but the spacing is applied with a unique character spacing' +
          ' instead.'
        Caption = 'Use text scaling'
        ParentShowHint = False
        ShowHint = True
        TabOrder = 13
      end
      object cbxClippingRgn: TCheckBox
        Left = 25
        Top = 276
        Width = 153
        Height = 21
        Hint = 'Disable clipping regions for debugging purposes'
        Caption = 'No Clipping Regions'
        ParentShowHint = False
        ShowHint = True
        TabOrder = 11
      end
      object cbxJPEG: TCheckBox
        Left = 25
        Top = 167
        Width = 168
        Height = 21
        Hint = 'Use JPEG compression for images'
        Caption = 'Use JPEG Compression'
        ParentShowHint = False
        ShowHint = True
        TabOrder = 7
      end
      object cbxCMYK: TCheckBox
        Left = 25
        Top = 207
        Width = 168
        Height = 21
        Hint = 'Convert all colors to DeviceCMYK.'
        Caption = 'Convert to CMYK'
        ParentShowHint = False
        ShowHint = True
        TabOrder = 9
      end
      object cbxNoUnicode: TCheckBox
        Left = 25
        Top = 148
        Width = 158
        Height = 21
        Hint = 
          'This flag can be set to disable Unicode output. Required to get ' +
          'PDF 1.2 compatible files.'
        Caption = 'No Unicode'
        ParentShowHint = False
        ShowHint = True
        TabOrder = 6
        OnClick = cbxNoUnicodeClick
      end
      object cbxScale: TCheckBox
        Left = 25
        Top = 187
        Width = 193
        Height = 21
        Hint = 
          'If set, coordinates are scaled to the output picture size. Stron' +
          'gly recommended for EMF files which use 32 bit coordinates becau' +
          'se such coordinates can exceeed PDF limits.'
        Caption = 'Scale coords to window size'
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clGreen
        Font.Height = -15
        Font.Name = 'MS Sans Serif'
        Font.Style = []
        ParentFont = False
        ParentShowHint = False
        ShowHint = True
        TabOrder = 8
      end
      object cbxUseRclFrame: TCheckBox
        Left = 25
        Top = 354
        Width = 173
        Height = 21
        Hint = 
          'If set, the picture size is computed by using the DPIX and DPIX ' +
          'factors of SetEMFFrameDPI() to enable a user defined calculation' +
          '. This can be useful to process old style WMF files where the pi' +
          'cture size is not known.'
        Caption = 'Use rclFrame'
        ParentShowHint = False
        ShowHint = True
        TabOrder = 15
        OnClick = cbxUseRclFrameClick
      end
      object cbxBkTransparent: TCheckBox
        Left = 25
        Top = 394
        Width = 188
        Height = 21
        Hint = 
          'The default background mode is opaque and this causes that text ' +
          'is drawn into a white rectangle if the background mode is not pr' +
          'operly initialized. Setting the default background mode to trans' +
          'parent can significantly reduce the PDF file size.'
        Caption = 'Init bk mode to transparent'
        ParentShowHint = False
        ShowHint = True
        TabOrder = 17
      end
      object cbxGDIFontSelection: TCheckBox
        Left = 25
        Top = 108
        Width = 178
        Height = 21
        Hint = 'Use a GDI device context to select fonts'
        Caption = 'GDI Font Selection'
        Checked = True
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clGreen
        Font.Height = -15
        Font.Name = 'MS Sans Serif'
        Font.Style = []
        ParentFont = False
        ParentShowHint = False
        ShowHint = True
        State = cbChecked
        TabOrder = 4
      end
      object cbxRclFrameEx: TCheckBox
        Left = 25
        Top = 374
        Width = 183
        Height = 21
        Hint = 
          'When this flag is set the output rectangle will be extended if t' +
          'he bounding box is larger than the output rectangle. This is pro' +
          'bably the correct way to compute the picture size.'
        Caption = 'Use rclFrame Ex'
        Checked = True
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clRed
        Font.Height = -15
        Font.Name = 'MS Sans Serif'
        Font.Style = []
        ParentFont = False
        ParentShowHint = False
        ShowHint = True
        State = cbChecked
        TabOrder = 16
        OnClick = cbxRclFrameExClick
      end
      object cbxDisableRasterEMF: TCheckBox
        Left = 25
        Top = 226
        Width = 178
        Height = 21
        Hint = 'Do not raster EMF files which use unsupported ROP codes.'
        Caption = 'Disable Raster EMF'
        Checked = True
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clRed
        Font.Height = -15
        Font.Name = 'MS Sans Serif'
        Font.Style = []
        ParentFont = False
        ParentShowHint = False
        ShowHint = True
        State = cbChecked
        TabOrder = 10
      end
      object cbxClipRclBounds: TCheckBox
        Left = 25
        Top = 89
        Width = 188
        Height = 21
        Hint = 
          'Clip the bounding box of the EMF file. This flag is normally not' +
          ' required because EMF files contain usually a meta region if it ' +
          'contains contents outside the bounding box.'
        Caption = 'Clip RclBounds'
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clBlack
        Font.Height = -15
        Font.Name = 'MS Sans Serif'
        Font.Style = []
        ParentFont = False
        ParentShowHint = False
        ShowHint = True
        TabOrder = 3
      end
      object cbxNoBBoxCheck: TCheckBox
        Left = 25
        Top = 249
        Width = 153
        Height = 16
        Caption = 'NoBBoxCheck'
        Checked = True
        Color = clBtnFace
        Font.Charset = DEFAULT_CHARSET
        Font.Color = clRed
        Font.Height = -15
        Font.Name = 'MS Sans Serif'
        Font.Style = []
        ParentColor = False
        ParentFont = False
        State = cbChecked
        TabOrder = 18
      end
    end
    object Tree: TShellTreeView
      Left = 0
      Top = 0
      Width = 218
      Height = 221
      ObjectTypes = [otFolders, otNonFolders]
      Root = 'rfMyComputer'
      UseShellImages = True
      Align = alClient
      AutoRefresh = False
      HideSelection = False
      Indent = 23
      ParentColor = False
      RightClickSelect = True
      ShowRoot = False
      TabOrder = 1
      OnClick = TreeClick
    end
  end
