<?xml version="1.0" encoding="UTF-8"?>
<report name="ExportDemo" tagLangVersion="1">
 <page width="210" height="297" marginLeft="15" marginTop="15" marginRight="15" marginBottom="15"/>
 <datasources><datasource alias="d" provider="csv" conn="03_data.csv"/></datasources>
 <bands>
  <band kind="reportheader" name="rh" height="14">
   <text name="ttl" x="0" y="0" w="180" h="8" fontSize="16" hAlign="center">Order Lines</text>
  </band>
  <band kind="detail" name="det" height="7" data="d">
   <text name="p" x="0" y="0" w="90" h="6" fontSize="10" wordWrap="0">{{d.product}}</text>
   <text name="q" x="90" y="0" w="30" h="6" fontSize="10" hAlign="right" wordWrap="0">{{d.qty}}</text>
   <text name="r" x="120" y="0" w="60" h="6" fontSize="10" hAlign="right" wordWrap="0">{{d.price}}</text>
  </band>
 </bands>
</report>
