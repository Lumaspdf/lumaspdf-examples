<?xml version="1.0" encoding="UTF-8"?>
<report name="BandsDemo" tagLangVersion="1">
 <page width="210" height="297" marginLeft="15" marginTop="15" marginRight="15" marginBottom="15"/>
 <datasources><datasource alias="d" provider="csv" conn="04_data.csv"/></datasources>
 <styles>
  <style name="Wm" fontSize="48" bold="1" textColor="00EEEEEE" hAlign="1" vAlign="1"/>
  <style name="Ov" fontSize="8" textColor="00B0B0B0" hAlign="2"/>
  <style name="Grp" fontSize="12" bold="1" textColor="00FFFFFF" backColor="002A6099" vAlign="1"/>
 </styles>
 <bands>
  <band kind="background" name="bg" height="297">
   <text name="wm" x="20" y="120" w="150" h="40" style="Wm" rotation="45" wordWrap="0">BACKGROUND</text>
  </band>
  <band kind="overlay" name="ov" height="297">
   <text name="ol" x="0" y="150" w="180" h="6" style="Ov" rotation="90" wordWrap="0">overlay band</text>
  </band>
  <band kind="reportheader" name="rh" height="16">
   <text name="rt" x="0" y="0" w="180" h="10" fontSize="18" hAlign="center">reportheader band</text>
  </band>
  <band kind="pageheader" name="ph" height="8">
   <text name="pt" x="0" y="0" w="180" h="6" fontSize="9" wordWrap="0">pageheader band - grp / item / val</text>
  </band>
  <band kind="groupheader" name="gh" group="d.grp" height="8">
   <text name="gt" x="0" y="0" w="180" h="7" style="Grp" wordWrap="0">groupheader band: {{d.grp}}</text>
  </band>
  <band kind="detail" name="det" height="6" data="d">
   <text name="di" x="4" y="0" w="120" h="5" fontSize="9" wordWrap="0">detail band: {{d.item}}</text>
   <text name="dv" x="130" y="0" w="46" h="5" fontSize="9" hAlign="right" wordWrap="0">{{d.val}}</text>
  </band>
  <band kind="groupfooter" name="gf" group="d.grp" height="7">
   <text name="ft" x="0" y="1" w="180" h="5" fontSize="9" italic="1" wordWrap="0">groupfooter band: end of {{d.grp}}</text>
  </band>
  <band kind="pagefooter" name="pf" height="7">
   <text name="pft" x="0" y="1" w="180" h="5" fontSize="8" hAlign="center" wordWrap="0">pagefooter band</text>
  </band>
  <band kind="summary" name="sm" height="16">
   <text name="st" x="0" y="2" w="180" h="10" fontSize="14" hAlign="center">summary band - report complete</text>
  </band>
 </bands>
</report>
