<?xml version="1.0" encoding="UTF-8"?>
<report name="Northwind" tagLangVersion="1">
 <page width="210" height="297" marginLeft="15" marginTop="15" marginRight="15" marginBottom="15"/>
 <datasources>
  <datasource alias="d" provider="odbc"
    conn="Driver={Microsoft Access Driver (*.mdb, *.accdb)};Dbq=Northwind.mdb;"
    query="SELECT c.CategoryName, p.ProductName, p.UnitPrice, p.UnitsInStock FROM Categories c INNER JOIN Products p ON c.CategoryID = p.CategoryID ORDER BY c.CategoryName, p.ProductName"/>
 </datasources>
 <bands>
  <band kind="reportheader" name="rh" height="14"><text name="t" x="0" y="0" w="180" h="10" fontSize="18" hAlign="center" wordWrap="0">Northwind Product Catalog</text></band>
  <band kind="pageheader" name="ph" height="8">
   <text name="c1" x="0" y="0" w="110" h="5" fontSize="9" bold="1" wordWrap="0">Product</text>
   <text name="c2" x="120" y="0" w="30" h="5" fontSize="9" bold="1" hAlign="right" wordWrap="0">Price</text>
   <text name="c3" x="152" y="0" w="28" h="5" fontSize="9" bold="1" hAlign="right" wordWrap="0">Stock</text>
  </band>
  <band kind="groupheader" name="gh" group="d.CategoryName" height="8"><text name="g" x="0" y="1" w="180" h="6" fontSize="12" bold="1" wordWrap="0">{{expr: d.CategoryName}}</text></band>
  <band kind="detail" name="det" height="6" data="d">
   <text name="p" x="4" y="0" w="110" h="5" fontSize="9" wordWrap="0">{{ProductName}}</text>
   <text name="pr" x="120" y="0" w="30" h="5" fontSize="9" hAlign="right" wordWrap="0">{{expr: FORMATNUM('#,##0.00', UnitPrice) }}</text>
   <text name="sk" x="152" y="0" w="28" h="5" fontSize="9" hAlign="right" wordWrap="0">{{UnitsInStock}}</text>
  </band>
  <band kind="groupfooter" name="gf" group="d.CategoryName" height="4"><text name="ge" x="4" y="0" w="176" h="4" fontSize="7" wordWrap="0">-- end of {{expr: d.CategoryName}} --</text></band>
  <band kind="pagefooter" name="pf" height="6"><text name="f" x="0" y="0" w="180" h="5" fontSize="7" hAlign="right" wordWrap="0">printed {{expr: FORMATDATE('yyyy-mm-dd', TODAY()) }}</text></band>
 </bands>
</report>
