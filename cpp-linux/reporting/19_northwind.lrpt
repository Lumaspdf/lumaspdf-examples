<?xml version="1.0" encoding="UTF-8"?>
<report name="Northwind Catalog" tagLangVersion="1">
  <page width="210" height="297" marginLeft="15" marginTop="15"
        marginRight="15" marginBottom="15"/>
  <datasources>
    <datasource alias="d" provider="csv" conn="19_northwind.csv"/>
  </datasources>
  <params>
    <param name="Title"   default="'Northwind Product Catalog'"/>
    <param name="Company" default="'LumasPDF Trading Co.'"/>
  </params>
  <styles>
    <style name="Bar"     backColor="005F3A1F" borderWidth="0"/>
    <style name="GrpBar"  backColor="002A170F" borderWidth="0"/>
    <style name="Title"   fontName="Helvetica" fontSize="22" bold="1" textColor="00FFFFFF" vAlign="1"/>
    <style name="Sub"     fontName="Helvetica" fontSize="9"  textColor="00FFFFFF" hAlign="2" vAlign="1"/>
    <style name="ColH"    fontName="Helvetica" fontSize="8"  bold="1" textColor="00FFFFFF" vAlign="1"/>
    <style name="ColHR"   fontName="Helvetica" fontSize="8"  bold="1" textColor="00FFFFFF" hAlign="2" vAlign="1"/>
    <style name="Grp"     fontName="Helvetica" fontSize="12" bold="1" textColor="00FFFFFF" vAlign="1"/>
    <style name="Cell"    fontName="Helvetica" fontSize="9"  textColor="002A170F" vAlign="1"/>
    <style name="CellR"   fontName="Helvetica" fontSize="9"  textColor="002A170F" hAlign="2" vAlign="1"/>
    <style name="Muted"   fontName="Helvetica" fontSize="8"  textColor="008B7464" vAlign="1"/>
    <style name="Sub L"   fontName="Helvetica" fontSize="8.5" bold="1" textColor="005F3A1F"/>
    <style name="SubR"    fontName="Helvetica" fontSize="8.5" bold="1" textColor="005F3A1F" hAlign="2"/>
    <style name="GTotL"   fontName="Helvetica" fontSize="11" bold="1" textColor="00FFFFFF"/>
    <style name="GTotR"   fontName="Helvetica" fontSize="11" bold="1" textColor="00FFFFFF" hAlign="2"/>
    <style name="Foot"    fontName="Helvetica" fontSize="7.5" textColor="008B7464"/>
    <style name="FootR"   fontName="Helvetica" fontSize="7.5" textColor="008B7464" hAlign="2"/>
  </styles>
  <bands>
    <band kind="reportheader" name="rh" height="26">
      <shape name="hbar"  x="0" y="0" w="180" h="18" style="Bar" shape="0"/>
      <text  name="ttl"   x="5"  y="1"  w="120" h="10" style="Title" wordWrap="0">{{var:Title}}</text>
      <text  name="sub"   x="95" y="6"  w="80"  h="6"  style="Sub"   wordWrap="0">{{var:Company}}</text>
      <text  name="asof"  x="0"  y="20" w="180" h="4"  style="Muted" wordWrap="0">Generated {{expr: FORMATDATE('yyyy-mm-dd', TODAY()) }} from Northwind data (csv provider)</text>
    </band>
    <band kind="pageheader" name="ph" height="8">
      <shape name="cbar" x="0" y="0" w="180" h="7" style="GrpBar" shape="0"/>
      <text name="hP"  x="3"   y="1.5" w="64" h="4" style="ColH"  wordWrap="0">PRODUCT</text>
      <text name="hK"  x="69"  y="1.5" w="44" h="4" style="ColH"  wordWrap="0">PACK</text>
      <text name="hU"  x="114" y="1.5" w="21" h="4" style="ColHR" wordWrap="0">PRICE</text>
      <text name="hS"  x="137" y="1.5" w="18" h="4" style="ColHR" wordWrap="0">STOCK</text>
      <text name="hV"  x="157" y="1.5" w="20" h="4" style="ColHR" wordWrap="0">VALUE</text>
    </band>
    <band kind="groupheader" name="gh" group="d.CategoryName" height="9">
      <shape name="gbar" x="0" y="1" w="180" h="7" style="GrpBar" shape="0"/>
      <text  name="gname" x="4" y="1.7" w="140" h="5" style="Grp" wordWrap="0">{{expr: d.CategoryName}}</text>
    </band>
    <band kind="detail" name="det" height="6" data="d">
      <shape name="zebra" x="0" y="0" w="180" h="6" shape="0" backColor="00F9F5F1" visible="RowNum % 2 = 0"/>
      <text name="cP" x="3"   y="1" w="64" h="4" style="Cell"  wordWrap="0">{{ProductName}}</text>
      <text name="cK" x="69"  y="1" w="44" h="4" style="Muted" wordWrap="0">{{QuantityPerUnit}}</text>
      <text name="cU" x="114" y="1" w="21" h="4" style="CellR" wordWrap="0">{{expr: FORMATNUM('#,##0.00', UnitPrice) }}</text>
      <text name="cS" x="137" y="1" w="18" h="4" style="CellR" wordWrap="0">{{UnitsInStock}}</text>
      <text name="cV" x="157" y="1" w="20" h="4" style="CellR" wordWrap="0">{{expr: FORMATNUM('#,##0', UnitPrice*UnitsInStock) }}</text>
      <line name="drow" orient="h" scope="section" vAlign="bottom" width="0.15" color="00E2D8CE"/>
    </band>
    <band kind="groupfooter" name="gf" group="d.CategoryName" height="7">
      <line name="gtop" orient="h" scope="section" vAlign="top" width="0.4" color="005F3A1F"/>
      <text name="sl" x="3"   y="1.5" w="110" h="4" style="Sub L" wordWrap="0">Subtotal -- {{expr: d.CategoryName}} ({{expr: COUNT()}} products)</text>
      <text name="sv" x="137" y="1.5" w="40"  h="4" style="SubR"  wordWrap="0">{{expr: FORMATNUM('#,##0', SUM(UnitPrice*UnitsInStock)) }}</text>
    </band>
    <band kind="summary" name="sm" height="16">
      <shape name="tbar" x="0" y="2" w="180" h="10" style="Bar" shape="0"/>
      <text name="gl" x="4"   y="4.2" w="120" h="6" style="GTotL" wordWrap="0">GRAND TOTAL -- {{expr: COUNT()}} products in {{expr: COUNTDISTINCT(d.CategoryName)}} categories</text>
      <text name="gv" x="120" y="4.2" w="56"  h="6" style="GTotR" wordWrap="0">{{expr: FORMATNUM('#,##0', SUM(UnitPrice*UnitsInStock)) }}</text>
    </band>
    <band kind="pagefooter" name="pf" height="9">
      <line name="ft" orient="h" scope="section" vAlign="top" width="0.3" color="00B9B9B9"/>
      <text name="fl" x="0"   y="2.5" w="120" h="4" style="Foot"  wordWrap="0">{{var:Company}} -- confidential</text>
      <text name="fr" x="120" y="2.5" w="57"  h="4" style="FootR" wordWrap="0">Page {{var:PageNo}} of {{var:TotalPages}}</text>
    </band>
  </bands>
</report>
