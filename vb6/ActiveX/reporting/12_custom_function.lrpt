<?xml version="1.0" encoding="UTF-8"?>
<report name="CustomFn" tagLangVersion="1">
 <page width="210" height="297" marginLeft="15" marginTop="15" marginRight="15" marginBottom="15"/>
 <params>
  <param name="Name1" default="(unset)"/>
  <param name="Name2" default="(unset)"/>
 </params>
 <bands>
  <band kind="reportheader" name="rh" height="30">
   <text name="g1" x="0" y="0"  w="180" h="8" fontSize="16">Hello, {{var:Name1}}!</text>
   <text name="g2" x="0" y="10" w="180" h="8" fontSize="12">Hello, {{var:Name2}}!</text>
  </band>
 </bands>
</report>
